# webhook の共有シークレット（16 文字以上）。例: openssl rand -hex 24
WEBHOOK_SECRET=
# LINE Messaging API のチャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=
# 送り先の userId / groupId / roomId（カンマ区切り）。空なら broadcast（友だち全員）
LINE_TO=
# PORT=8080
# CONFIG_PATH=config.json
# 送信元 IP の許可リスト（カンマ区切りの IPv4）。空 = 制限なし。X-Forwarded-For の末尾で判定するので、
# Cloud Run など X-Forwarded-For を付け足すフロントの後ろでだけ使う（例: 192.0.2.1,198.51.100.7）
# ALLOWED_SOURCE_IPS=
